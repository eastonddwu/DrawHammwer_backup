<!--
  tcmcenter.xml.tmpl — TCM 主配置模板（3rdparty/init_env/apps/tcm/cfg/ 下这份是
  TCM 实际加载的活文件，由 tcm_admin.sh 的 auto_tcmcenter_xml() 读取并二次 sed
  替换 CenterdAddr/TconndAddr 生成 tcmcenter.xml.auto，这才是二进制真正加载的
  文件）。

  本 .tmpl 文件中的 __APP_ROOT__ 占位符会在每次 `./start.sh start` 时由
  render_tcm_configs()（见 start.sh）动态替换为当前 app_server 的实际绝对路
  径，生成同目录下的 tcmcenter.xml（该生成文件不应手工编辑，修改请编辑本
  .tmpl 文件）。
-->
<tcmcenter
    CenterdAddr="0.0.2.1"
    TconndAddr="0.0.3.1"
    BussinessID="0"
    AddrTemple="function:8.world:8.zone:4.instance:12"
    OpenCreateCfgByScript="1"
    CreateCfgScriptFile="__APP_ROOT__/cfg/gen_app_conf.sh"
    ConfigBaseDir="__APP_ROOT__/conf"
    MsgRoundTime="20"
    HostConfFile="__APP_ROOT__/cfg/host.xml"
    ProcConfFile="__APP_ROOT__/cfg/proc.xml"
    ProcDeployFile="__APP_ROOT__/cfg/deploy.xml"
    BusRelationFile="__APP_ROOT__/cfg/bus_relation.xml"
    AccessWhiteListFile="__APP_ROOT__/cfg/access_whitelist.xml"
    TappPidFileDir="__APP_ROOT__/pid" >
</tcmcenter>
